{
  "name": "azatech-shop",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel dev",
    "build": "pnpm --filter api build && pnpm --filter web build",
    "test": "pnpm --filter api test",
    "test:e2e": "pnpm --filter api test:e2e",
    "lint": "pnpm --recursive lint",
    "format": "pnpm --recursive format"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "bcrypt",
      "esbuild",
      "sharp",
      "msgpackr-extract"
    ]
  }
}
